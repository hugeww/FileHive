# ==========================================
# FileHive 基础运行环境配置
# ==========================================

# 服务监听地址与端口
HOST=0.0.0.0
PORT=12345

# 运行环境模式 (production / development)
APP_ENV=production

# 日志输出级别 (trace, debug, info, warn, error)
RUST_LOG=info,filehive_server=info

# ==========================================
# 数据库配置 (三选一，默认内置 SQLite)
# ==========================================
# 1. SQLite 模式（默认，数据自动存放在挂载的 data 目录）：
DATABASE_URL=sqlite:data/filehive.db

# 2. PostgreSQL 模式：
# DATABASE_URL=postgres://user:password@postgres:5432/filehive

# 3. MySQL / MariaDB 模式：
# DATABASE_URL=mysql://user:password@mysql:3306/filehive
