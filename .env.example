# ==========================================
# FileHive 镜像与容器配置
# ==========================================
# 镜像地址与版本控制（默认 0.1.1 / latest）
FILEHIVE_IMAGE=ghcr.io/hugeww/filehive:0.1.1

# ==========================================
# 网络与端口配置
# ==========================================
# 宿主机绑定地址（0.0.0.0 允许外部公网访问；127.0.0.1 仅允许本机/反向代理访问）
BIND_HOST=0.0.0.0

# 宿主机映射端口（访问地址：http://${BIND_HOST}:${SERVER_PORT}）
SERVER_PORT=12345

# 运行环境模式 (production / development)
APP_ENV=production

# 日志输出级别 (trace, debug, info, warn, error)
RUST_LOG=info,filehive_server=info

# ==========================================
# 数据库配置 (三选一，默认内置 SQLite)
# ==========================================
# 1. SQLite 模式（默认，数据自动存放在持久化卷 /app/data 中）：
DATABASE_URL=sqlite:data/filehive.db

# 2. PostgreSQL 模式（可使用 host.docker.internal 访问宿主机或外部容器网络）：
# DATABASE_URL=postgres://user:password@postgres:5432/filehive

# 3. MySQL / MariaDB 模式：
# DATABASE_URL=mysql://user:password@mysql:3306/filehive
